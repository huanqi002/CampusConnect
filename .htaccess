RewriteEngine On

# Preserve the original public URLs while keeping route entry files categorized.
RewriteRule ^(account_created|forgot_password|login|logout|register|reset_password|verify_reset_code)\.php$ routes/auth/$1.php [L]
RewriteRule ^(become_volunteer|edit_profile|profile|profile_cover|profile_picture|public_profile|volunteer)\.php$ routes/profile/$1.php [L]
RewriteRule ^(change_password|password_changed|set_new_password|verify_password_otp)\.php$ routes/security/$1.php [L]